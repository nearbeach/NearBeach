        in: query
        description: A page number within the paginated result set.
        schema:
          type: integer
      tags:
      - Organisation
      security:
      - oauth2: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/PaginatedCustomerList'
          description: ''
        '403':
          description: Not logged in, or no permission for this organisation
        '404':
          description: Organisation not found
    post:
      operationId: organisation_customer_create
      description: Returns the complete list of customers linked to the organisation.
      summary: Link a customer to a organisation
      parameters:
      - in: path
        name: id
        schema:
          type: integer
        description: A unique integer value identifying this organisation.
        required: true
      - name: page
        required: false
        in: query
        description: A page number within the paginated result set.
        schema:
          type: integer
      tags:
      - Organisation
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/CustomerLink'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/CustomerLink'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/CustomerLink'
        required: true
      security:
      - oauth2: []
      responses:
        '201':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/PaginatedCustomerList'
          description: ''
        '400':
          description: Invalid input - field errors, or a message such as 'Object
            does not exist'
        '403':
          description: Not logged in, or no permission for this organisation
        '404':
          description: Organisation not found
  /api/v1/organisation/{id}/customer/{customer_pk}/:
    get:
      operationId: organisation_customer_retrieve
      description: Class for the organisation view set
      parameters:
      - in: path
        name: customer_pk
        schema:
          type: string
          pattern: ^\d+$
        required: true
      - in: path
        name: id
        schema:
          type: integer
        description: A unique integer value identifying this organisation.
        required: true
      tags:
      - organisation
      security:
      - oauth2: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Organisation'
          description: ''
    patch:
      operationId: organisation_customer_partial_update
      description: Class for the organisation view set
      parameters:
      - in: path
        name: customer_pk
        schema:
          type: string
          pattern: ^\d+$
        required: true
      - in: path
        name: id
        schema:
          type: integer
        description: A unique integer value identifying this organisation.
        required: true
      tags:
      - organisation
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/PatchedOrganisation'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/PatchedOrganisation'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/PatchedOrganisation'
      security:
      - oauth2: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Organisation'
          description: ''
    delete:
      operationId: organisation_customer_destroy
      description: Delete a customer from an organisation
      summary: Unlink a customer from a organisation
      parameters:
      - in: path
        name: customer_pk
        schema:
          type: integer
        description: ID of the customer link
        required: true
      - in: path
        name: id
        schema:
          type: integer
        description: A unique integer value identifying this organisation.
        required: true
      tags:
      - Organisation
      security:
      - oauth2: []
      responses:
        '204':
          description: No response body
        '400':
          description: Invalid input - field errors, or a message such as 'Object
            does not exist'
        '403':
          description: Not logged in, or no permission for this organisation
        '404':
          description: Organisation not found
  /api/v1/organisation/{id}/documents/:
