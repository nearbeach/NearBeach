                $ref: '#/components/schemas/ProjectDetail'
          description: ''
        '403':
          description: Not logged in, or no permission for this project
        '404':
          description: Project not found
    patch:
      operationId: project_partial_update
      description: Send only the fields to change. Groups, users and organisation
        have their own endpoints, and `status` is the id of a project status. The
        response is the updated project in this same shape.
      summary: Update a project
      parameters:
      - in: path
        name: id
