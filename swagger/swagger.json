components:
  schemas:
    BlankEnum:
      enum:
      - ''
    Customer:
      type: object
      description: Class containing serializer for Customer
      properties:
        id:
          type: integer
          readOnly: true
        title:
          $ref: '#/components/schemas/CustomerTitle'
        first_name:
          type: string
        last_name:
          type: string
        email:
          type: string
          format: email
        profile_picture_path:
          type: string
          nullable: true
          readOnly: true
      required:
      - email
      - first_name
      - id
      - last_name
      - profile_picture_path
      - title
    CustomerLink:
      type: object
      description: Class containing serializer for Customer links
      properties:
        id:
          type: integer
      required:
      - id
    CustomerTitle:
      type: object
      description: Class containing serializer for Customer Title
      properties:
        id:
          type: integer
          readOnly: true
        title:
          type: string
          maxLength: 10
      required:
      - id
      - title
    Document:
      type: object
      description: Class for document serialization
      properties:
        key:
          type: string
          format: uuid
          readOnly: true
