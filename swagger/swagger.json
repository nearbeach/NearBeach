          multipart/form-data:
            schema:
              $ref: '#/components/schemas/PatchedDocument'
      security:
      - oauth2: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Document'
          description: ''
        '400':
          description: Invalid input - field errors, or a message such as 'Object
            does not exist'
        '403':
          description: Not logged in, or no permission for this organisation
        '404':
          description: Organisation not found
    delete:
      operationId: organisation_documents_destroy
      description: Class for the organisation view set
      summary: Delete a document from a organisation
      parameters:
      - in: path
        name: document_pk
        schema:
          type: integer
        description: ID of the document
        required: true
      - in: path
        name: id
        schema:
          type: integer
        description: A unique integer value identifying this organisation.
        required: true
      tags:
      - Organisation
      security:
      - oauth2: []
      responses:
        '204':
