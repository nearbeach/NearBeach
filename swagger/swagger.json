openapi: 3.0.3
info:
  title: NearBeach API
  version: 0.0.1
  description: "\n# NearBeach API Guide\n\nNearBeach is an open source project management
    system, built using Django for the backend, and VueJS for the frontend.\n\nThe
    following documentation covers all API endpoints for NearBeach. You can use these
    endpoints to help;\n- **C**reate objects\n- **R**ead objects\n- **U**pdate objects\n-
    **D**elete objects\n\n# Features\n\n- **Basic Organisation/Customer**: Users will
    be able to gather information on Organisations/Customers\n- **Customer Requirements**:
    Users will be able to gather requirements from customers\n- **Kanban Board**:
    Users will be able to track tasks within a kanban board\n- **Project/Tasks**:
    Users will be able to create projects/tasks\n- **Request for Change**: Users will
    be able to setup a RFC for deployment processes\n\n# Helpful Links\n\n[NearBeach
    Documentation Guide](https://nearbeach.readthedocs.io/en/latest/)\n\n[Discord](https://discord.gg/64uhRztS6n)\n\n[Self-hosting](https://nearbeach.org/self-hosting/)\n\n[Source
    Code](https://github.com/NearBeach/NearBeach)\n    "
paths:
  /api/v1/authentication/:
    post:
      operationId: authentication_create
      description: Function to authenticate a user.
      tags:
      - authentication
      security:
      - {}
      responses:
        '200':
          description: No response body
  /api/v1/authentication/forgotten-password/:
    post:
      operationId: authentication_forgotten_password_create
      description: Class dealing with forgotten password
      tags:
      - authentication
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/ForgottenPassword'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/ForgottenPassword'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/ForgottenPassword'
        required: true
      security:
      - {}
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ForgottenPassword'
          description: ''
  /api/v1/authentication/oidc/providers/:
    get:
      operationId: authentication_oidc_providers_list
      description: Lists the single sign-on providers the login page should offer
      tags:
      - authentication
      security:
      - {}
      responses:
        '200':
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: '#/components/schemas/OidcProvider'
          description: ''
  /api/v1/authentication/reset-password/:
    post:
      operationId: authentication_reset_password_create
      description: Method handling post requests for password reset
      tags:
      - authentication
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/PasswordReset'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/PasswordReset'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/PasswordReset'
        required: true
      security:
      - {}
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/PasswordReset'
          description: ''
  /api/v1/data/potential_object_links/:
    get:
      operationId: data_potential_object_links_list
      description: Projects, requirements, requirement items and tasks that belong
        to a group the user is in.
      summary: List objects that can be linked
      parameters:
      - in: query
        name: q
        schema:
          type: string
        description: Search string
      tags:
      - Search
      security:
      - oauth2: []
      responses:
        '200':
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: '#/components/schemas/PotentialObjectLink'
          description: ''
  /api/v1/organisation/:
    get:
      operationId: organisation_list
      description: Paginated list of organisations the user can see. Filter with `?search=`
        (title or id).
      summary: List organisations
      parameters:
      - name: page
        required: false
        in: query
        description: A page number within the paginated result set.
        schema:
          type: integer
      tags:
      - Organisation
      security:
      - oauth2: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/PaginatedOrganisationList'
          description: ''
        '403':
          description: Not logged in, or no permission for this organisation
        '404':
          description: Invalid page number
    post:
      operationId: organisation_create
      description: Requires permission level 3 or above. `group_list` is required
        and must only contain groups the user belongs to.
      summary: Create a organisation
      tags:
      - Organisation
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/Organisation'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/Organisation'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/Organisation'
        required: true
      security:
      - oauth2: []
      responses:
        '201':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Organisation'
          description: ''
        '400':
          description: Invalid input - field errors, or a message such as 'Object
            does not exist'
        '403':
          description: Not logged in, or no permission for this organisation
  /api/v1/organisation/{id}/:
    get:
      operationId: organisation_retrieve
      description: Class for the organisation view set
      summary: Get a organisation
      parameters:
      - in: path
        name: id
        schema:
          type: integer
        description: A unique integer value identifying this organisation.
        required: true
      tags:
      - Organisation
      security:
      - oauth2: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Organisation'
          description: ''
        '403':
          description: Not logged in, or no permission for this organisation
        '404':
          description: Organisation not found
    patch:
      operationId: organisation_partial_update
      description: Class for the organisation view set
      parameters:
      - in: path
        name: id
        schema:
          type: integer
        description: A unique integer value identifying this organisation.
        required: true
      tags:
      - organisation
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/PatchedOrganisation'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/PatchedOrganisation'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/PatchedOrganisation'
      security:
      - oauth2: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Organisation'
          description: ''
    delete:
      operationId: organisation_destroy
      description: Soft-deletes the organisation. Requires full permission (level
        4).
      summary: Delete a organisation
      parameters:
      - in: path
        name: id
        schema:
          type: integer
        description: A unique integer value identifying this organisation.
        required: true
      tags:
      - Organisation
      security:
      - oauth2: []
      responses:
        '204':
          description: No response body
        '403':
          description: Not logged in, or no permission for this organisation
        '404':
          description: Organisation not found
  /api/v1/organisation/{id}/customer/:
    get:
