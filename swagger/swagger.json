  /api/v1/project/{id}/:
    get:
      operationId: project_retrieve
      summary: Get a project
      parameters:
      - in: path
        name: id
        schema:
          type: integer
        description: A unique integer value identifying this project.
        required: true
      tags:
      - Projects
      security:
      - oauth2: []
      responses:
        '200':
          content:
            application/json:
